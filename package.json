		"sunrise-sunset-js": "^2.2.1",
		"valibot": "^1.2.0"
	},
	"scripts": {
		"build": "eslint && tsc && vitest run --config ./vitest.config.mts && node esbuild.config.mjs --prod",
		"build-dev": "tsc && node esbuild.config.mjs",
		"lint": "eslint",
		"publish": "eslint && tsc && vitest run --config ./vitest.config.mts && node esbuild.config.mjs --prod && node scripts/publish.mjs",
		"publish-dev": "tsc && node esbuild.config.mjs && node scripts/publish.mjs",
		"test": "vitest run --config ./vitest.config.mts"
	}
